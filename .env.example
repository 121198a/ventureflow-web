# ==============================================================================
# VentureFlow / UnBound X - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# For production deployments (Vercel, Netlify, Hostinger, VPS, Docker), configure these
# variables in your hosting provider's dashboard or environment settings.
#
# NOTE: Variables prefixed with NEXT_PUBLIC_ are exposed to the client-side
# browser bundle. Do NOT store sensitive private keys in NEXT_PUBLIC_ variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Site Configuration (Required for Production)
# ------------------------------------------------------------------------------
# Canonical production domain (no trailing slash). Used for metadataBase,
# Open Graph / Twitter cards, sitemap.xml, robots.txt, and canonical links.
# Example: https://ventureflow.vercel.app or https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://unboundx.example

# ------------------------------------------------------------------------------
# 2. Database, Auth & Storage (Free-Tier Compatible)
# ------------------------------------------------------------------------------
# Uses Supabase Free Tier (500MB PostgreSQL, 1GB Storage, 50k MAU auth).
# Required for: Careers resume file uploads to storage bucket 'resumes'.
# Fallback for: User authentication and newsletter subscriber storage.
# Sign up free at: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# ------------------------------------------------------------------------------
# 3. External Backend API Endpoints (Configurable / Fallback included)
# ------------------------------------------------------------------------------
# UBverse backend API base URL for company data, issuer details, backend auth,
# and newsletter sync.
NEXT_PUBLIC_UBVERSE_API_URL=https://development.unboundxinc.us/api

# Dashboard endpoint (derived from UBVERSE_API_URL if omitted)
NEXT_PUBLIC_UBVERSE_DASHBOARD_URL=https://development.unboundxinc.us/api/ubverse-service/investor-dashboard/dashboard-without-auth

# CMS API endpoint for legal pages content
NEXT_PUBLIC_CMS_API_URL=https://development.unboundxinc.us/api/user-service/user/cms-pages

# Authentication redirect destination (default is internal '/login')
NEXT_PUBLIC_LOGIN_URL=/login

# ------------------------------------------------------------------------------
# 4. Student & Free-Tier Budget Optimizations (Optional)
# ------------------------------------------------------------------------------
# Set to 'true' to disable server-side image transformation.
# Recommended for:
#  - Vercel Free Tier (avoids exceeding the 1,000 free monthly image optimization quota)
#  - Low-memory VPS (Hostinger $2-4/mo or 512MB RAM servers, avoids high CPU/RAM usage)
#  - Static CDN deployments
NEXT_PUBLIC_UNOPTIMIZED_IMAGES=false

# Next.js build output mode:
#  - 'true' (default): Generates .next/standalone for Docker, VPS, Hostinger Node.js, and Cloud containers
#  - 'false': Standard build without standalone isolation
NEXT_OUTPUT_STANDALONE=true

# ------------------------------------------------------------------------------
# 5. Optional Analytics & Tracking (Degrades gracefully if left blank)
# ------------------------------------------------------------------------------
# Server-only Branch.io key (never exposed to browser)
BRANCH_KEY=
# NEXT_PUBLIC_BRANCH_PAGEVIEW_URL=https://api2.branch.io/v1/pageview


