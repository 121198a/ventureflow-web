# Copy this file to .env.local and fill in real values for your environment.
# Both vars below are intentionally NEXT_PUBLIC_* — they are safe to expose
# to the browser (a base URL and a redirect URL, not secrets/keys).
# Do NOT put private API keys, DB credentials, or server secrets in
# NEXT_PUBLIC_* vars — anything prefixed NEXT_PUBLIC_ is bundled into
# client-side JS and visible to anyone.

# Canonical production domain (no trailing slash). Used for metadataBase,
# Open Graph/Twitter image resolution, sitemap.xml and robots.txt. Set this
# to the real deployed domain before going live.
NEXT_PUBLIC_SITE_URL=https://unboundx.example

# Base URL for the UnBound X CMS ("cms-pages") API used by /legal pages.
NEXT_PUBLIC_CMS_API_URL=https://development.unboundxinc.us/api/user-service/user/cms-pages

# UBverse backend API base URL. The app uses this for public company data,
# issuer details, backend authentication, newsletter subscription, and support chat.
# Override this for staging/production; the development URL is the built-in fallback.
NEXT_PUBLIC_UBVERSE_API_URL=https://development.unboundxinc.us/api

# Optional explicit dashboard endpoint. Normally derived from NEXT_PUBLIC_UBVERSE_API_URL.
NEXT_PUBLIC_UBVERSE_DASHBOARD_URL=https://development.unboundxinc.us/api/ubverse-service/investor-dashboard/dashboard-without-auth

# Where "Get started" / "Start your record" / login CTAs open.
# Leave unset to use the built-in /login page.
NEXT_PUBLIC_LOGIN_URL=/login

# Server-only secret — Branch.io key for pageview tracking (app/api/branch).
# Never prefix this with NEXT_PUBLIC_. Optional: tracking degrades
# gracefully (no-op) when unset, so it's safe to leave blank in preview
# environments.
BRANCH_KEY=
